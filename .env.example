# ==============================================================================
# VertexAI Environment Variables Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Port 5432)
# ------------------------------------------------------------------------------
POSTGRES_DB=vertexai_db
POSTGRES_USER=vertex_user
POSTGRES_PASSWORD=vertex_secure_pass
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Spring Boot 3 Core Backend Configuration (Port 8080)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vertexai_db
SPRING_DATASOURCE_USERNAME=vertex_user
SPRING_DATASOURCE_PASSWORD=vertex_secure_pass
AGENTS_SERVICE_URL=http://python-agents:8000
JWT_SECRET=your_jwt_secret_key_must_be_at_least_256_bits_long_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. GitHub REST API Integration (Team 1 sole owner: GitHubTicketingService.java)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO_OWNER=aryanosh
GITHUB_REPO_NAME=VertexAI

# ------------------------------------------------------------------------------
# 4. Python AI Agents Microservice Configuration (Port 8000)
# ------------------------------------------------------------------------------
AGENTS_PORT=8000
BACKEND_URL=http://backend:8080
USE_MOCKS=true
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
FIRST_EPSS_URL=https://api.first.org/data/v1/epss
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ------------------------------------------------------------------------------
# 5. Next.js 14 Frontend UI Configuration (Port 3000)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/pipeline
