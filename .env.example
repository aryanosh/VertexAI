# ==============================================================================
# VertexAI — Environment Template
#
# This is the SINGLE configuration file for the whole stack. docker-compose.yml
# reads it and passes the values to all four services, so there is no per-service
# .env to keep in sync.
#
#   cp .env.example .env      then edit .env with your real values
#
# NEVER commit .env, and never put real secrets in THIS template file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL (host port 5433)
# ------------------------------------------------------------------------------
# POSTGRES_PORT is the HOST port. Inside the Docker network the container still
# listens on 5432; docker-compose maps "5433:5432".
POSTGRES_DB=vertexai_db
POSTGRES_USER=vertex_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Spring Boot backend (port 8080)
# ------------------------------------------------------------------------------
# These target a LOCAL run (mvn spring-boot:run) against Postgres on 5433.
# docker-compose overrides them with container-internal values (postgres:5432),
# so editing them here cannot break the Docker stack.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vertexai_db
DB_USER=vertex_user
DB_PASSWORD=change_me_db_password

# Must be at least 256 bits for HMAC-SHA256.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# Seed account passwords (development convenience only).
ADMIN_PASSWORD=change_me_admin
ANALYST_PASSWORD=change_me_analyst
VIEWER_PASSWORD=change_me_viewer

# ------------------------------------------------------------------------------
# 3. GitHub ticketing integration
# ------------------------------------------------------------------------------
# Fine-grained PAT with "Issues: read and write" on the target repo only.
# Leave blank to disable ticket dispatch.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name

# ------------------------------------------------------------------------------
# 4. Python AI agents (port 8000)
# ------------------------------------------------------------------------------
AGENTS_PORT=8000
AGENTS_SERVICE_URL=http://python-agents:8000
BACKEND_URL=http://backend:8080

# USE_MOCKS=true  -> Agent 3 reads bundled offline fixtures in agents_service/mocks/.
#                    Fast and works without internet, but the KEV/EPSS values are
#                    NOT live exploit intelligence. The dashboard labels this state.
# USE_MOCKS=false -> Agent 3 queries the live feeds below.
USE_MOCKS=true
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
FIRST_EPSS_URL=https://api.first.org/data/v1/epss
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# ------------------------------------------------------------------------------
# 4b. Agentic AI reasoning (NVIDIA NIM, OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
# LLM_ENABLED=true turns Agent 3 into a genuine goal-directed agent: it decides which
# threat-intel tools to call (CISA KEV / EPSS / NVD / Exploit-DB), in what order, and when it
# has gathered enough evidence. With false, Agent 3 runs its original fixed two-call sequence.
#
# The agent never invents numbers. Scores come only from real tool results, and it cannot
# alter a suppression decision or a risk score — those stay in deterministic code.
#
# Falls back to deterministic behaviour automatically if the key is missing, the endpoint
# errors, or the agent exceeds its time/iteration budget.
LLM_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Nemotron reasoning mode. Returns its chain of thought in a separate reasoning_content
# field, which the runtime records into the agent trace for human audit.
#
# Measured for one tool-selection turn: thinking ON ~42.6s / 282 completion tokens,
# thinking OFF ~4.6s / 40 tokens. Both selected the correct tool. Defaults to false because
# choosing an intel source does not need deep reasoning; enable when you want the recorded
# rationale and can accept roughly 9x the latency.
LLM_ENABLE_THINKING=false
LLM_REASONING_BUDGET=2048
LLM_TOP_P=0.95
LLM_MAX_TOKENS=1200

# Safety rails for the agent loop.
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_ITERATIONS=8
LLM_REQUEST_TIMEOUT=40
LLM_TEMPERATURE=0.2
INTEL_HTTP_TIMEOUT=8
EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# CVEs are investigated concurrently. AGENT3_MAX_CVES caps how many get the agentic
# treatment per request so a large scan cannot become thousands of model calls; the
# remainder use the deterministic path.
AGENT3_CONCURRENCY=5
AGENT3_MAX_CVES=25

# ------------------------------------------------------------------------------
# 5. Next.js frontend (port 3000)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_* values are embedded into the browser bundle at build time.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/pipeline

# ------------------------------------------------------------------------------
# 6. Scanner sandbox (port 9000)
# ------------------------------------------------------------------------------
SCAN_TIMEOUT_SECONDS=300
