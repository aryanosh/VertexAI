# --- NVIDIA Nemotron (all 4 agents use this for their explanation/reasoning layer) ---
# Server-side only. Never exposed to the frontend or included in any API response.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Master switch. Defaults to true, but agents still fall back to deterministic behavior
# whenever NVIDIA_API_KEY is empty, so the demo runs offline with no key configured.
LLM_ENABLED=true

# Emit the model's chain-of-thought into the audit trace (never into agent responses).
# Off by default: measurably slower, and tool selection doesn't need deep reasoning.
LLM_ENABLE_THINKING=false
LLM_REASONING_BUDGET=2048

AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_ITERATIONS=8
LLM_REQUEST_TIMEOUT=40
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.95
LLM_MAX_TOKENS=1200

# --- Agent 3 (Threat Intelligence) ---
# Bounds on agentic CVE investigation so a large scan can't fan out into thousands of calls.
AGENT3_CONCURRENCY=5
AGENT3_MAX_CVES=25

# true = use bundled offline KEV/EPSS fixtures (mocks/mock_kev.json, mocks/mock_epss.json).
# false = query live CISA KEV / FIRST.org EPSS / NVD / Exploit-DB feeds.
USE_MOCKS=true
